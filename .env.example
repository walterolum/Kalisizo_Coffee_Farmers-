# ---------------------------------------------------------------------------
# PostgreSQL — two connection strings, on purpose
# ---------------------------------------------------------------------------
# DATABASE_URL is what the application connects as. It should be a role that is
# NOT a superuser and does NOT have BYPASSRLS, so that the row level security
# policies are actually consulted rather than bypassed. Postgres lets a table's
# owner ignore its own policies unless the table is also FORCEd, so connecting as
# the owner would make every policy decorative - `npm run db:rls-verify` proves
# this either way rather than assuming it.
#
# The role is created by migration 20261002000000_row_level_security. Give it a
# password once per environment:
#   ALTER ROLE kalisizo_app WITH LOGIN PASSWORD '...';
DATABASE_URL="postgresql://kalisizo_app:CHANGE_ME@localhost:5432/kalisizo_coffee?schema=public"

# Migrations run as the table owner over a direct (non-pooled) connection. This
# split is what lets the application role hold no DDL rights at all, so it cannot
# alter the very schema whose row security it depends on.
#
# Must be port 5432. A transaction pooler on 6543 cannot run CREATE ROLE or
# ALTER TABLE ... FORCE, so a pooled URL here fails at migrate time with an error
# that does not obviously point at the pooler.
DIRECT_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/kalisizo_coffee?schema=public"

# Authentication — set a strong random secret in production (e.g. `openssl rand -hex 32`)
# The app refuses to boot in production while JWT_SECRET is missing or still the dev fallback.
JWT_SECRET="replace-with-a-long-random-secret"

# Default admin bootstrapped by the seed script (change after first login)
ADMIN_EMAIL="admin@kalisizocoop.coop"
ADMIN_PASSWORD=""

# Where contact-form notifications are delivered
CONTACT_INBOX="kalisizocoop@gmail.com"

# Allowed browser origins for CORS (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"

# Public canonical origin used for metadataBase, canonical, sitemap.xml and robots.txt.
# Set to the production origin (e.g. https://kalisizo.coffee) before deploying.
NEXT_PUBLIC_SITE_URL=""

# ---------------------------------------------------------------------------
# Storage (admin image uploads)
# ---------------------------------------------------------------------------
# Uploads go to one of three backends, chosen automatically in this order:
# Supabase Storage, then Cloudinary, then local disk. Check what a deployment
# actually resolved with:  npm run storage:status
#
# Pin the choice with STORAGE_BACKEND. This is worth setting rather than relying
# on the order above, because a cutover normally has the old and new variables
# present at the same time. A pinned backend that is not configured makes uploads
# fail with a 503 naming the missing variable, rather than quietly sending media
# somewhere you did not intend.
#   STORAGE_BACKEND="supabase"   # or "cloudinary", "local", "auto"
STORAGE_BACKEND=""

# Supabase Storage — the target backend. Objects live in a *public* bucket and are
# served by URL, because the CMS stores that URL as durable content. The bucket
# name and project URL are therefore part of your data model: changing either
# needs a data migration, not just a config change.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Defaults to "cms-media" when blank.
SUPABASE_STORAGE_BUCKET=""

# Cloudinary — the outgoing backend, kept working during and after the migration
# so a rollback is a one-line change. Cloudinary does not support read-back or
# delete through the storage adapter; the CMS serves those objects by URL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Opt in to storing uploads on local disk in production. Only for a self-hosted
# Node server with a persistent, writable filesystem. Leave unset on Vercel and
# other ephemeral platforms. Anything other than 1/true/yes/on counts as off.
# ALLOW_LOCAL_UPLOADS="true"

# Where local uploads are written. May be absolute (a mounted volume) or relative
# to the project root. Must NOT be inside public/: Next.js serves public/ from a
# file list captured at server start, so files written after startup would 404.
# UPLOAD_DIR="data/uploads"

# Resend (transactional email). Leave blank to log emails instead of sending
RESEND_API_KEY=""
RESEND_FROM="Kalisizo Coffee <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Realtime (live updates in the CMS and on public pages)
# ---------------------------------------------------------------------------
# Two transports, chosen by REALTIME_BACKEND. Check what a deployment resolved
# to with:  npm run realtime:status
#
#   sse       in-process broadcaster feeding an EventSource stream. Needs no
#             configuration, and is correct on a single Node server. It cannot
#             reach a second instance: each one holds its own subscriber set, so
#             an admin saving on instance A never notifies a visitor attached to
#             instance B. Updates still arrive on the poll timer, so the symptom
#             is "live updates feel slow", not an error.
#   supabase  Supabase Realtime Broadcast, which reaches every subscriber
#             regardless of which instance handled the write. This is what makes
#             the deployment horizontal-safe.
#
# Defaults to "sse" when unset, because it is the only backend that can be
# correct without any configuration.
#   REALTIME_BACKEND="supabase"   # or "sse", "auto"
REALTIME_BACKEND=""

# The `supabase` transport needs the same SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# as Storage above, plus these two for the browser to subscribe. The anon key is
# public by design — it is published in every Supabase client bundle — so it is
# safe in NEXT_PUBLIC_* precisely because it only grants what row security allows,
# which for these tables is nothing. Never put the service role key in a
# NEXT_PUBLIC_ variable; it bypasses row security entirely.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Broadcast payloads are restricted to collection names by
# `assertSafeToBroadcast`, because the channel is public until Supabase Auth
# replaces the application's own JWT. Nothing row-shaped goes on it: a subscriber
# is told which collections changed and re-fetches through the ordinary
# authorized API.