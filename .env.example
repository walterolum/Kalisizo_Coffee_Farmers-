# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres@localhost:5432/kalisizo_coffee?schema=public"

# Authentication — set a strong random secret in production (e.g. `openssl rand -hex 32`)
# The app refuses to boot in production while JWT_SECRET is missing or still the dev fallback.
JWT_SECRET="replace-with-a-long-random-secret"

# Default admin bootstrapped by the seed script (change after first login)
ADMIN_EMAIL="admin@kalisizocoop.coop"
ADMIN_PASSWORD=""

# Where contact-form notifications are delivered
CONTACT_INBOX="kalisizocoop@gmail.com"

# Allowed browser origins for CORS (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000"

# Public canonical origin used for metadataBase, canonical, sitemap.xml and robots.txt.
# Set to the production origin (e.g. https://kalisizo.coffee) before deploying.
NEXT_PUBLIC_SITE_URL=""

# Cloudinary (admin image uploads). Leave blank to store uploads on local disk.
# Cloudinary is the intended production backend: with these blank, uploads are
# written to UPLOAD_DIR and served by the /uploads/[file] route, which is fine on
# a self-hosted server with a persistent filesystem but loses every file on an
# ephemeral (container/serverless) platform, so the upload route returns HTTP 503
# there unless ALLOW_LOCAL_UPLOADS is set.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Opt in to storing uploads on local disk in production. Only for a self-hosted
# Node server with a persistent, writable filesystem. Leave unset on Vercel and
# other ephemeral platforms. Anything other than 1/true/yes/on counts as off.
# ALLOW_LOCAL_UPLOADS="true"

# Where local uploads are written. May be absolute (a mounted volume) or relative
# to the project root. Must NOT be inside public/: Next.js serves public/ from a
# file list captured at server start, so files written after startup would 404.
# UPLOAD_DIR="data/uploads"

# Resend (transactional email). Leave blank to log emails instead of sending
RESEND_API_KEY=""
RESEND_FROM="Kalisizo Coffee <onboarding@resend.dev>"