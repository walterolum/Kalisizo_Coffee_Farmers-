# ---------------------------------------------------------------------------
# Production environment template
# ---------------------------------------------------------------------------
# Copy to `.env` on the server and fill in every value marked REQUIRED.
# `docker compose` reads this file automatically.
#
#   cp .env.example.production .env
#   chmod 600 .env
#
# Never commit the filled-in `.env`. It is already in .gitignore.

# --- Site address -----------------------------------------------------------

# REQUIRED. The bare origin, no trailing slash, no path. Drives metadataBase,
# canonical tags, sitemap.xml, robots.txt and CORS. Changing this requires an
# image rebuild, because NEXT_PUBLIC_ variables are inlined at build time.
NEXT_PUBLIC_SITE_URL="https://kalisizo.coffee"

# REQUIRED. The domain Caddy issues a certificate for. Leave as localhost to
# serve plain HTTP on ports 80/443 without a certificate.
SITE_DOMAIN="kalisizo.coffee"

# --- Secrets ----------------------------------------------------------------

# REQUIRED. `openssl rand -hex 32`. The app throws on boot in production if this
# is missing or still equals the known dev fallback. Changing it invalidates
# every issued admin session, so everyone has to log in again.
JWT_SECRET=""

# REQUIRED. Password for the Postgres container.
#
# Generate with `openssl rand -hex 24`. Hex is deliberate: Compose interpolates
# this value directly into DATABASE_URL, so a password containing `@ : / ? #`
# or `%` would produce a malformed connection string and the app would fail on
# every query with "invalid port number in database URL". `rand -base64` and
# `rand -alnum` are safe; `rand -base64` is NOT, because it emits `+` and `/`.
POSTGRES_PASSWORD=""

# --- Database ---------------------------------------------------------------

# Defaults are fine for a single-host deployment. Override only if you have
# moved Postgres to a managed provider, in which case delete the `db` service
# from docker-compose.yml.
POSTGRES_USER="kalisizo"
POSTGRES_DB="kalisizo_coffee"

# --- Admin bootstrap --------------------------------------------------------

# Only used by `npm run db:seed`, on a database with no admin account yet.
# Password policy, enforced by the seed in production: at least 12 characters,
# at most 200, and at least three of lowercase, uppercase, digits, symbols.
ADMIN_EMAIL="admin@kalisizocoop.coop"
ADMIN_PASSWORD=""

# --- Image uploads ----------------------------------------------------------

# Leave ALLOW_LOCAL_UPLOADS=true and uploads go to a Docker named volume that
# survives rebuilds and redeploys. This is the recommended default.
#
# Set the CLOUDINARY_* values and leave ALLOW_LOCAL_UPLOADS unset to move images
# to Cloudinary instead. Do both or neither: with local uploads enabled AND
# Cloudinary configured, every upload goes to Cloudinary, so an existing
# /uploads/... logoUrl in the database keeps pointing at this box and the volume
# becomes orphaned. Migrate those URLs before switching.
ALLOW_LOCAL_UPLOADS="true"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Transactional email ----------------------------------------------------

# Leave RESEND_API_KEY blank and contact forms are logged to stdout instead of
# sent. Safe for a first deploy; you will not receive inquiries.
RESEND_API_KEY=""
RESEND_FROM="Kalisizo Coffee <onboarding@resend.dev>"

# Where contact-form submissions are delivered.
CONTACT_INBOX="kalisizocoop@gmail.com"